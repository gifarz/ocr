# Copy to .env and fill in for production. Generate the key with:
#   openssl rand -hex 32
OCR_SERVICE_API_KEY=

# Tesseract language packs (requires `apt-get install tesseract-ocr-ind`
# on the host in addition to the base tesseract-ocr package).
OCR_LANGUAGES=ind+eng

# Leave unset unless tesseract isn't on PATH.
TESSERACT_CMD=

# Max upload size in bytes. Default: 15 MB.
OCR_MAX_UPLOAD_BYTES=15728640

# Never enable in production - logs raw OCR text (contains NIK/PII).
OCR_DEBUG_LOG_RAW_TEXT=false
